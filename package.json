{
  "name": "download_media",
  "version": "1.0.0",
  "description": "Sistema web moderno para download e extração de áudio e vídeo com yt-dlp e ffmpeg",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i public/css/input.css -o public/css/tailwind.css --minify",
    "dev:css": "tailwindcss -c tailwind.config.js -i public/css/input.css -o public/css/tailwind.css --watch",
    "prestart": "[ -x node_modules/.bin/tailwindcss ] && npm run build:css || true"
  },
  "keywords": [
    "yt-dlp",
    "ffmpeg",
    "downloader",
    "web-ui",
    "media-downloader",
    "audio-extractor"
  ],
  "author": "Antigravity Expert Development",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "lucide": "^0.469.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
